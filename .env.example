# Telegram excrete pipe
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=60000

# Optional local proxy notes:
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Douban mirror local-only account sync
# Prefer a local cookie file so secrets do not enter shell history.
DOUBAN_COOKIE_FILE=cookies/douban.txt
# DOUBAN_COOKIE=
DOUBAN_USER_AGENT=Mozilla/5.0 DoubanMirrorSync/0.3
DOUBAN_SYNC_LIMIT_PER_TYPE=20

# Steam game resource read-only probe
# Create a key locally at https://steamcommunity.com/dev/apikey.
# Do not paste the key into chat and do not commit real secrets.
STEAM_API_KEY=
STEAM_ID=
STEAM_PROBE_OUT_DIR=资源/_steam
STEAM_PROBE_GAME_CSV=资源/游戏.csv
STEAM_PROBE_RECENT_COUNT=0
# Optional: achievement checks are slower and per-app; keep off by default.
STEAM_PROBE_ACHIEVEMENTS=0
STEAM_PROBE_ACHIEVEMENT_LIMIT=20

# MetaNode Go backend homework blog API
APP_ENV=development
SERVER_PORT=8080
DB_DRIVER=sqlite
DB_DSN=blog.db
JWT_SECRET=change-me-in-local-env
JWT_EXPIRE_HOURS=24
