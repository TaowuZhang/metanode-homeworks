# Hardhat 3 reads these variables from the shell environment.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY

# Optional overrides. Defaults in scripts use the common Sepolia Chainlink addresses below.
SEPOLIA_ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
SEPOLIA_LINK_TOKEN=0x779877A7B0D9E8603169DdbD7836e478b4624789
SEPOLIA_LINK_USD_FEED=0xc59E3633BAAC79493d908e63626716e204A45EdF

# Required only for upgrading an already deployed proxy.
AUCTION_PROXY_ADDRESS=
MIN_BID_INCREMENT_BPS=500
